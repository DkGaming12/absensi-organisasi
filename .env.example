# Firebase project ID dari Firebase Console → Project settings → General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Pilih salah satu cara kredensial Admin SDK:
# A) Service account JSON di luar folder project (disarankan untuk lokal)
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/firebase-service-account.json
# B) Atau isi pasangan ini (private key simpan sebagai satu baris dengan \n)
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Rahasia untuk token sesi anggota dan admin
JWT_SECRET=replace-with-a-long-random-secret

# Admin bootstrap: dipakai saat login pertama, lalu password hash disimpan di Firestore
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password
ADMIN_NAMA=Admin Organisasi

# Opsional, hanya jika sinkronisasi Google Sheets masih digunakan
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
# GOOGLE_SHEET_ID=
# SYNC_SECRET=

# Opsional, hanya jika fitur AI digunakan
# OPENROUTER_API_KEY=
